# --- Twitch (https://dev.twitch.tv/console) ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Token utilisateur avec le scope clips:edit (uniquement si AUTO_CREATE_CLIPS=true)
TWITCH_USER_TOKEN=

# --- Kick ---
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# --- Claude ---
# api = facturé à l'usage ; subscription = abonnement Claude via Claude Code installé sur le PC
CLAUDE_BACKEND=api
ANTHROPIC_API_KEY=
# Si la clé n'est rattachée à aucun workspace : ID du workspace (wrkspc_...)
ANTHROPIC_WORKSPACE_ID=
CLAUDE_MODEL=claude-opus-5-5
# Effort de réflexion : low, medium, high (plus haut = meilleur mais plus cher)
DECIDE_EFFORT=medium
COMPOSE_EFFORT=medium
MIN_TRANSCRIPT_WORDS=6

# --- Validation (Telegram) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Pipeline ---
TOP_N_STREAMS=10
STREAM_LANGUAGE=en
CLIP_LANGUAGE=en
POLL_INTERVAL_S=45
AUTO_CREATE_CLIPS=false
SPIKE_RATIO=3.0
MAX_PARALLEL_RENDERS=1
DB_PATH=data/autoclip.db
WORK_DIR=data/work
